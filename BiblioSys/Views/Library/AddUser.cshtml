@model Bibliosys.Model.User

@{
    ViewData["Title"] = "AddUser";
}

<h1>Dołącz do BiblioSys!</h1>

<h4>Utwórz konto</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="AddUser">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label class="control-label">Imię</label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">Nazwisko</label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">Email</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label class="control-label">Hasło</label>

                <div class="input-group">
                    <input id="password" asp-for="Password" type="password" class="form-control" />

                    <button type="button" class="btn btn-outline-secondary" onclick="togglePassword()">
                        👁
                    </button>
                </div>

                <span asp-validation-for="Password" class="text-danger"></span>
            </div>



            
            <div class="form-group">
                <input type="submit" value="Gotowe" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Masz już konto? Zaloguj się!</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function togglePassword() {
            const input = document.getElementById("password");

            if (input.type === "password") {
                input.type = "text";
            } else {
                input.type = "password";
            }
        }
    </script>
}
