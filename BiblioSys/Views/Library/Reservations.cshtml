@model Bibliosys.Model.Reservation

@{
    ViewData["Title"] = "Dodaj rezerwację";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">

            <div class="card shadow-sm border-0">
                <div class="card-header bg-light py-3 px-4 border-bottom">
                    <h5 class="mb-0 fw-semibold text-dark">Informacje o rezerwacji</h5>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Reservations" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                                <strong>Błąd walidacji</strong> - Sprawdź poprawność danych w formularzu.
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark mb-2">
                                Książka <span class="text-danger">*</span>
                            </label>
                            <div class="searchable-select" id="bookSelect">
                                <input type="text" class="form-control search-input" placeholder="Wyszukaj książkę..." autocomplete="off" />
                                <input type="hidden" name="BookId" id="BookId" />
                                <span class="text-danger small d-block mt-1" id="BookId-error"></span>
                                <div class="dropdown-list border rounded bg-white shadow-sm" style="display:none; max-height:220px; overflow-y:auto; position:absolute; z-index:1000; width:100%;">
                                    @foreach (var item in ViewBag.BookId as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                                    {
                                        <div class="dropdown-item-option p-2 px-3" data-value="@item.Value" style="cursor:pointer;">@item.Text</div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark mb-2">
                                Użytkownik <span class="text-danger">*</span>
                            </label>
                            <div class="searchable-select" id="userSelect">
                                <input type="text" class="form-control search-input" placeholder="Wyszukaj użytkownika..." autocomplete="off" />
                                <input type="hidden" name="UserId" id="UserId" />
                                <span class="text-danger small d-block mt-1" id="UserId-error"></span>
                                <div class="dropdown-list border rounded bg-white shadow-sm" style="display:none; max-height:220px; overflow-y:auto; position:absolute; z-index:1000; width:100%;">
                                    @foreach (var item in ViewBag.UserId as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                                    {
                                        <div class="dropdown-item-option p-2 px-3" data-value="@item.Value" style="cursor:pointer;">@item.Text</div>
                                    }
                                </div>
                            </div>
                        </div>

                        <input type="hidden" asp-for="ReservationDate" />

                        <div class="d-grid gap-2 d-md-flex mt-5">
                            <button type="submit" class="btn btn-primary fw-semibold flex-md-grow-1">
                                Zapisz rezerwację
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary fw-semibold">
                                Anuluj
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-4">
                <a asp-action="Index" class="text-muted text-decoration-none small">
                    Powrót do biblioteki
                </a>
            </div>

        </div>
    </div>
</div>

<style>
    .form-control:focus,
    .form-select:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15);
    }
    .btn-primary { background-color: #0d6efd; border-color: #0d6efd; }
    .btn-primary:hover { background-color: #0b5ed7; border-color: #0b5ed7; }
    .card { border-radius: 0.375rem; }
    .searchable-select { position: relative; }
    .dropdown-item-option:hover { background-color: #f0f4ff; }
    .dropdown-item-option.selected { background-color: #e7efff; font-weight: 600; }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.querySelectorAll(".searchable-select").forEach(function (container) {
            var input = container.querySelector(".search-input");
            var hidden = container.querySelector("input[type=hidden]");
            var list = container.querySelector(".dropdown-list");
            var options = Array.from(container.querySelectorAll(".dropdown-item-option"));

            input.addEventListener("focus", function () {
                filterOptions("");
                list.style.display = "block";
            });

            input.addEventListener("input", function () {
                hidden.value = "";
                filterOptions(input.value);
                list.style.display = "block";
            });

            options.forEach(function (opt) {
                opt.addEventListener("mousedown", function (e) {
                    e.preventDefault();
                    hidden.value = opt.dataset.value;
                    input.value = opt.textContent.trim();
                    options.forEach(function (o) { o.classList.remove("selected"); });
                    opt.classList.add("selected");
                    list.style.display = "none";
                });
            });

            document.addEventListener("click", function (e) {
                if (!container.contains(e.target)) {
                    list.style.display = "none";
                    if (!hidden.value) input.value = "";
                }
            });

            function filterOptions(query) {
                var q = query.toLowerCase();
                options.forEach(function (opt) {
                    var match = opt.textContent.toLowerCase().includes(q);
                    opt.style.display = match ? "block" : "none";
                });
            }
        });

        document.querySelector("form").addEventListener("submit", function (e) {
            var valid = true;
            ["BookId", "UserId"].forEach(function (id) {
                var hidden = document.getElementById(id);
                var err = document.getElementById(id + "-error");
                if (!hidden.value) {
                    err.textContent = "To pole jest wymagane.";
                    valid = false;
                } else {
                    err.textContent = "";
                }
            });
            if (!valid) e.preventDefault();
        });
    </script>
}