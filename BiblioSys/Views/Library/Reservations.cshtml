@model Bibliosys.Model.Reservation

@{
    ViewData["Title"] = "Reservations";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="mb-5 text-center">
                <h1 class="display-5 fw-bold text-dark mb-2">📋 Dodaj rezerwację</h1>
                <p class="text-muted fs-5">Wypożycz książkę dla użytkownika</p>
            </div>

            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-gradient text-white p-4 border-0">
                    <h5 class="mb-0 fw-bold">📝 Formularz rezerwacji</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Reservations" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-group mb-4">
                            <label asp-for="BookId" class="form-label fw-semibold text-dark mb-2">
                                📚 Książka <span class="text-danger">*</span>
                            </label>
                            <select asp-for="BookId" class="form-select form-select-lg rounded-3 border-2" asp-items="ViewBag.BookId">
                                <option value="">-- Wybierz książkę --</option>
                            </select>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="UserId" class="form-label fw-semibold text-dark mb-2">
                                👤 Użytkownik <span class="text-danger">*</span>
                            </label>
                            <select asp-for="UserId" class="form-select form-select-lg rounded-3 border-2" asp-items="ViewBag.UserId">
                                <option value="">-- Wybierz użytkownika --</option>
                            </select>
                        </div>

                        <input type="hidden" asp-for="ReservationDate" />

                        <div class="form-group mb-4">
                            <label asp-for="ReturnDate" class="form-label fw-semibold text-dark mb-2">
                                📅 Data zwrotu <span class="text-danger"></span>
                            </label>
                            <input asp-for="ReturnDate" class="form-control form-control-lg rounded-3 border-2" />
                            <span asp-validation-for="ReturnDate" class="text-danger small d-block mt-2"></span>
                        </div>

                        <div class="form-group mb-5">
                            <label asp-for="AdditionalFee" class="form-label fw-semibold text-dark mb-2">
                                💸 Dodatkowa opłata
                            </label>
                            <input asp-for="AdditionalFee" class="form-control form-control-lg rounded-3 border-2" />
                            <span asp-validation-for="AdditionalFee" class="text-danger small d-block mt-2"></span>
                        </div>

                        <div class="d-grid gap-2 d-md-flex">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold rounded-3 flex-md-grow-1">
                                ✓ Zapisz rezerwację
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg fw-bold rounded-3">
                                ← Anuluj
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-4">
                <a asp-action="Index" class="text-muted text-decoration-none">
                    ← Powrót do biblioteki
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gradient {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #667eea !important;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25) !important;
    }

    .form-control-lg,
    .form-select-lg {
        font-size: 1rem;
        padding: 0.75rem 1rem;
    }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1rem rgba(102, 126, 234, 0.4) !important;
        }

    .card {
        border-radius: 1.5rem !important;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}