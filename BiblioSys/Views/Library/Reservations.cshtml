@model Bibliosys.Model.Reservation

@{
    ViewData["Title"] = "Dodaj rezerwację";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">

            <div class="card shadow-sm border-0">
                <div class="card-header bg-light py-3 px-4 border-bottom">
                    <h5 class="mb-0 fw-semibold text-dark">Informacje o rezerwacji</h5>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Reservations" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                                <strong>Błąd walidacji</strong> - Sprawdź poprawność danych w formularzu.
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }

                        <div class="mb-4">
                            <label asp-for="BookId" class="form-label fw-semibold text-dark mb-2">
                                Książka <span class="text-danger">*</span>
                            </label>
                            <select asp-for="BookId"
                                    class="form-select"
                                    asp-items="ViewBag.BookId">
                                <option value="">-- Wybierz książkę --</option>
                            </select>
                            <span asp-validation-for="BookId" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="UserId" class="form-label fw-semibold text-dark mb-2">
                                Użytkownik <span class="text-danger">*</span>
                            </label>
                            <select asp-for="UserId"
                                    class="form-select"
                                    asp-items="ViewBag.UserId">
                                <option value="">-- Wybierz użytkownika --</option>
                            </select>
                            <span asp-validation-for="UserId" class="text-danger small d-block mt-1"></span>
                        </div>

                        <input type="hidden" asp-for="ReservationDate" />

                        @* <div class="mb-4">
                            <label asp-for="ReturnDate" class="form-label fw-semibold text-dark mb-2">
                                Data zwrotu
                            </label>
                            <input asp-for="ReturnDate" class="form-control" type="date" />
                            <span asp-validation-for="ReturnDate" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="AdditionalFee" class="form-label fw-semibold text-dark mb-2">
                                Dodatkowa opłata
                            </label>
                            <input asp-for="AdditionalFee"
                                   class="form-control"
                                   placeholder="0,00" />
                            <span asp-validation-for="AdditionalFee" class="text-danger small d-block mt-1"></span>
                        </div> *@

                        <div class="d-grid gap-2 d-md-flex mt-5">
                            <button type="submit" class="btn btn-primary fw-semibold flex-md-grow-1">
                                Zapisz rezerwację
                            </button>

                            <a asp-action="Index" class="btn btn-outline-secondary fw-semibold">
                                Anuluj
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-4">
                <a asp-action="Index"
                       class="text-muted text-decoration-none small">
                    Powrót do biblioteki
                </a>
            </div>

        </div>
    </div>
</div>

<style>
    .form-control:focus,
    .form-select:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15);
    }

    .btn-primary {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }

        .btn-primary:hover {
            background-color: #0b5ed7;
            border-color: #0b5ed7;
        }

    .card {
        border-radius: 0.375rem;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}