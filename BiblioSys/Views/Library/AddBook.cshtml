@model Bibliosys.Model.Book

@{
    ViewData["Title"] = "Dodaj książkę";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="mb-5">
                <h1 class="h2 fw-bold text-dark mb-2">Dodaj nową książkę</h1>
                <p class="text-muted">Uzupełnij szczegóły nowej pozycji w kolekcji</p>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-light py-3 px-4 border-bottom">
                    <h5 class="mb-0 fw-semibold text-dark">Informacje o książce</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="AddBook" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                                <strong>Błąd walidacji</strong> - Sprawdź poprawność danych w formularzu.
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark mb-2">
                                Tytuł <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Title" class="form-control" placeholder="Wpisz tytuł książki..." />
                            <span asp-validation-for="Title" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark mb-2">
                                Kategoria <span class="text-danger">*</span>
                            </label>
                            <div class="searchable-select" id="categorySelect">
                                <input type="text" class="form-control search-input" placeholder="Wyszukaj kategorię..." autocomplete="off" />
                                <input type="hidden" name="Category" id="CategoryHidden" />
                                <span class="text-danger small d-block mt-1" id="Category-error"></span>
                                <div class="dropdown-list border rounded bg-white shadow-sm" style="display:none; max-height:220px; overflow-y:auto; position:absolute; z-index:1000; width:100%;">
                                    @foreach (var item in Html.GetEnumSelectList<BiblioSys.Enums.Category>())
                                    {
                                        <div class="dropdown-item-option p-2 px-3" data-value="@item.Value">@item.Text</div>
                                    }
                                </div>
                            </div>
                            <span asp-validation-for="Category" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark mb-2">
                                Autor <span class="text-danger">*</span>
                            </label>
                            <div class="input-group align-items-start">
                                <div class="searchable-select flex-grow-1" id="authorSelect">
                                    <input type="text" class="form-control search-input" placeholder="Wyszukaj autora..." autocomplete="off" />
                                    <input type="hidden" name="AuthorId" id="AuthorIdHidden" />
                                    <span class="text-danger small d-block mt-1" id="AuthorId-error"></span>
                                    <div class="dropdown-list border rounded bg-white shadow-sm" style="display:none; max-height:220px; overflow-y:auto; position:absolute; z-index:1000; width:100%;">
                                        @if (ViewBag.Authors != null)
                                        {
                                            @foreach (var author in ViewBag.Authors)
                                            {
                                                <div class="dropdown-item-option p-2 px-3" data-value="@author.Id">@author.FirstName @author.LastName</div>
                                            }
                                        }
                                    </div>
                                </div>
                                <a asp-action="AddAuthor" class="btn btn-outline-secondary ms-2" title="Dodaj nowego autora">
                                    Dodaj autora
                                </a>
                            </div>
                            <span asp-validation-for="AuthorId" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark mb-2">
                                Opis <span class="text-muted">(opcjonalnie)</span>
                            </label>
                            <textarea asp-for="Description" class="form-control" rows="5" placeholder="Wpisz krótki opis książki..."></textarea>
                            <small class="text-muted d-block mt-1">Maks. 2000 znaków</small>
                            <span asp-validation-for="Description" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="mb-4">
                            <div class="form-check form-switch">
                                <input type="checkbox" asp-for="IsFree" class="form-check-input" id="IsFree" />
                                <label class="form-check-label fw-semibold text-dark" for="IsFree">
                                    Książka jest dostępna
                                </label>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex mt-5">
                            <button type="submit" class="btn btn-primary fw-semibold flex-md-grow-1">
                                Dodaj książkę
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary fw-semibold">
                                Anuluj
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-4">
                <a asp-action="Index" class="text-muted text-decoration-none small">
                    Powrót do biblioteki
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control:focus,
    .form-select:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15);
    }
    .btn-primary { background-color: #0d6efd; border-color: #0d6efd; }
    .btn-primary:hover { background-color: #0b5ed7; border-color: #0b5ed7; }
    .card { border-radius: 0.375rem; }
    .form-check-input:checked { background-color: #0d6efd; border-color: #0d6efd; }
    .searchable-select { position: relative; }
    .dropdown-item-option:hover { background-color: #f0f4ff; }
    .dropdown-item-option.selected { background-color: #e7efff; font-weight: 600; }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.querySelectorAll(".searchable-select").forEach(function (container) {
            var input = container.querySelector(".search-input");
            var hidden = container.querySelector("input[type=hidden]");
            var list = container.querySelector(".dropdown-list");
            var options = Array.from(container.querySelectorAll(".dropdown-item-option"));

            input.addEventListener("focus", function () {
                filterOptions("");
                list.style.display = "block";
            });

            input.addEventListener("input", function () {
                hidden.value = "";
                filterOptions(input.value);
                list.style.display = "block";
            });

            options.forEach(function (opt) {
                opt.addEventListener("mousedown", function (e) {
                    e.preventDefault();
                    hidden.value = opt.dataset.value;
                    input.value = opt.textContent.trim();
                    options.forEach(function (o) { o.classList.remove("selected"); });
                    opt.classList.add("selected");
                    list.style.display = "none";
                });
            });

            document.addEventListener("click", function (e) {
                if (!container.contains(e.target)) {
                    list.style.display = "none";
                    if (!hidden.value) input.value = "";
                }
            });

            function filterOptions(query) {
                var q = query.toLowerCase();
                options.forEach(function (opt) {
                    opt.style.display = opt.textContent.toLowerCase().includes(q) ? "block" : "none";
                });
            }
        });

        document.querySelector("form").addEventListener("submit", function (e) {
            var valid = true;
            [["CategoryHidden", "Category-error"], ["AuthorIdHidden", "AuthorId-error"]].forEach(function (pair) {
                var hidden = document.getElementById(pair[0]);
                var err = document.getElementById(pair[1]);
                if (!hidden.value) {
                    err.textContent = "To pole jest wymagane.";
                    valid = false;
                } else {
                    err.textContent = "";
                }
            });
            if (!valid) e.preventDefault();
        });
    </script>
}