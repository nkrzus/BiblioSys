@model IEnumerable<Bibliosys.Model.Reservation>

@{
    ViewData["Title"] = "Moje rezerwacje";
}

<div class="container mt-5 mb-5">

    <div class="row mb-5 pb-4 border-bottom">
        <div class="col-12">
            <h2 class="h4 fw-bold text-dark mb-2">Moje rezerwacje</h2>
            <p class="text-muted mb-0">
                Przeglądaj swoje aktywne i zakończone wypożyczenia
            </p>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="card shadow-sm border-0">

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Autor</th>
                                <th>Tytuł</th>
                                <th>Data rezerwacji</th>
                                <th>Data zwrotu</th>
                                <th>Opłata</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-muted">
                                        @(item.Book.Author != null
                                            ? item.Book.Author.FirstName + " " + item.Book.Author.LastName
                                            : "Brak autora")
                                    </td>

                                    <td class="fw-semibold text-dark">
                                        @item.Book.Title
                                    </td>

                                    <td class="text-muted">
                                        @item.ReservationDate.ToString("dd.MM.yyyy")
                                    </td>

                                    <td class="text-muted">
                                        @(item.ReturnDate.HasValue
                                            ? item.ReturnDate.Value.ToString("dd.MM.yyyy")
                                            : "-")
                                    </td>

                                    <td>
                                        @if (item.AdditionalFee > 0)
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger fw-semibold">
                                                @item.AdditionalFee zł
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success fw-semibold">
                                                Brak opłat
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.Status == Bibliosys.Model.ReservationStatus.Aktywna)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success fw-semibold">
                                                Aktywna
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary fw-semibold">
                                                Zakończona
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row mt-5">
            <div class="col-md-8 mx-auto text-center py-5">
                <h4 class="text-dark fw-bold mb-3">
                    Brak rezerwacji
                </h4>

                <p class="text-muted mb-0">
                    Nie masz jeszcze żadnych rezerwacji.
                </p>
            </div>
        </div>
    }
    ```

</div>

<style>
    .card {
        border-radius: 0.375rem;
    }

    .table > :not(caption) > * > * {
        vertical-align: middle;
        padding: 1rem;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(13, 110, 253, 0.04);
    }
</style>
