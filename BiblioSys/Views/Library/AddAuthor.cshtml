@model Bibliosys.Model.Author

@{
    ViewData["Title"] = "Dodaj autora";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-5">
            <!-- Nagłówek -->
            <div class="mb-5">
                <h1 class="h2 fw-bold text-dark mb-2">Dodaj nowego autora</h1>
                <p class="text-muted">Zarejestruj nowego twórcę do bazy danych</p>
            </div>

            <!-- Karta formularza -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light py-3 px-4 border-bottom">
                    <h5 class="mb-0 fw-semibold text-dark">Dane autora</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="AddAuthor" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <!-- Walidacja podsumowanie -->
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                                <strong>Błąd walidacji</strong> - Sprawdź poprawność danych w formularzu.
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        <!-- Imię -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark mb-2">
                                Imię <span class="text-danger">*</span>
                            </label>
                            <input asp-for="FirstName" class="form-control" placeholder="Wpisz imię autora..." />
                            <span asp-validation-for="FirstName" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Nazwisko -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark mb-2">
                                Nazwisko <span class="text-danger">*</span>
                            </label>
                            <input asp-for="LastName" class="form-control" placeholder="Wpisz nazwisko autora..." />
                            <span asp-validation-for="LastName" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Przyciski -->
                        <div class="d-grid gap-2 d-md-flex mt-5">
                            <button type="submit" class="btn btn-primary fw-semibold flex-md-grow-1">
                                Dodaj autora
                            </button>
                            <a asp-action="AddBook" class="btn btn-outline-secondary fw-semibold">
                                Anuluj
                            </a>
                        </div>

                        <!-- Powrót -->
                        <div class="text-center mt-4 small">
                            <a asp-action="AddBook" class="text-muted text-decoration-none">
                                Powrót do dodawania książki
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control:focus,
    .form-select:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15);
    }

    .btn-primary {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }

    .btn-primary:hover {
        background-color: #0b5ed7;
        border-color: #0b5ed7;
    }

    .card {
        border-radius: 0.375rem;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
