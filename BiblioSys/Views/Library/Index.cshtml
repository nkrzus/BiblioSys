@model IEnumerable<Bibliosys.Model.Book>

@{
    ViewData["Title"] = "Biblioteka Książek";
}

<div class="container mt-5 mb-5">
    <!-- Sekcja zarządzania -->
    @if (Context.Session.GetInt32("IsAdmin") == 1)
    {
        <div class="row mb-5 pb-4 border-bottom">
            <div class="col-md-8">
                <h2 class="h4 fw-bold text-dark mb-2">Kolekcja książek</h2>
                <p class="text-muted mb-0">Wszystkie pozycje w naszej bibliotece</p>
            </div>
            <div class="col-md-4 text-end">
                <a asp-action="AddBook" class="btn btn-primary fw-semibold">
                    Dodaj nową książkę
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row mb-5 pb-4 border-bottom">
            <div class="col-12">
                <h2 class="h4 fw-bold text-dark mb-2">Dostępne książki</h2>
                <p class="text-muted mb-0">Przeglądaj naszą bogatą kolekcję</p>
            </div>
        </div>
    }

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm book-card">
                        <div class="card-body d-flex flex-column">
                            <!-- Tytuł -->
                            <h5 class="card-title fw-bold text-dark mb-3 flex-grow-0" style="font-size: 1.1rem; line-height: 1.5; min-height: 2.2em;">
                                @Html.DisplayFor(modelItem => item.Title)
                            </h5>

                            <!-- Metadane -->
                            <div class="mb-3 small">
                                <div class="mb-2">
                                    <span class="badge bg-light text-dark border border-secondary">
                                        @Html.DisplayFor(modelItem => item.Category)
                                    </span>
                                </div>
                                <div class="text-muted">
                                    <strong>Autor:</strong> @(item.Author != null ? item.Author.FirstName + " " + item.Author.LastName : "Brak autora")
                                </div>
                            </div>

                            <!-- Status dostępności -->
                            <div class="mb-3">
                                @if (item.IsFree)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success fw-semibold">
                                        Dostępna
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger fw-semibold">
                                        Wypożyczona
                                    </span>
                                }
                            </div>

                            <hr class="my-2" />

                            <!-- Opis -->
                            <p class="card-text text-muted small flex-grow-1" style="line-height: 1.5;">
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    if (item.Description.Length > 120)
                                    {
                                        @item.Description.Substring(0, 120)<span>...</span>
                                    }
                                    else
                                    {
                                        @item.Description
                                    }
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Brak opisu</span>
                                }
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="row mt-5">
            <div class="col-md-8 mx-auto text-center py-5">
                <h4 class="text-dark fw-bold mb-3">Brak książek w bibliotece</h4>
                <p class="text-muted mb-5">Biblioteka jest obecnie pusta. Zaloguj się na konto administratora, aby dodać pierwszą pozycję.</p>
                <a asp-action="Login" class="btn btn-primary fw-semibold me-2">
                    Zaloguj się
                </a>
                <a asp-action="AddUser" class="btn btn-outline-primary fw-semibold">
                    Utwórz konto
                </a>
            </div>
        </div>
    }
</div>

<style>
    .book-card {
        border-radius: 0.5rem;
        transition: all 0.2s ease-in-out;
    }

    .book-card:hover {
        box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.1) !important;
    }

    .card-body {
        padding: 1.5rem;
    }
</style>
