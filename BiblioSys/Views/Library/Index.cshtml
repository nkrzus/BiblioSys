@model IEnumerable<Bibliosys.Model.Book>

@{
    ViewData["Title"] = "Biblioteka Książek";
}

<div class="container mt-5 mb-5">
    <div class="row mb-5 align-items-center">
        <div class="col-md-8">
            <h1 class="display-4 fw-bold text-dark mb-2">📚 Biblioteka Książek</h1>
            <p class="text-muted fs-5">Przeglądaj naszą bogatą kolekcję książek</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="AddBook" class="btn btn-primary btn-lg fw-bold rounded-pill px-4">
                <span>➕</span> Dodaj nową książkę
            </a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 hover-shadow rounded-3 overflow-hidden">
                        <div class="card-body p-4">
                            <!-- Tytuł książki -->
                            <h5 class="card-title fw-bold text-dark mb-3" style="font-size: 1.2rem; line-height: 1.4;">
                                @Html.DisplayFor(modelItem => item.Title)
                            </h5>

                            <!-- Kategoria i Dostępność -->
                            <div class="mb-3 d-flex flex-wrap gap-2">
                                <span class="badge bg-info bg-opacity-10 text-info fw-semibold px-3 py-2">
                                    📖 @Html.DisplayFor(modelItem => item.Category)
                                </span>
                                @if (item.IsFree)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success fw-semibold px-3 py-2">
                                        ✓ Dostępna
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger fw-semibold px-3 py-2">
                                        ✗ Wypożyczona
                                    </span>
                                }
                            </div>

                            <hr class="my-3" />

                            <!-- Autor -->
                            <p class="mb-3 small">
                                <strong class="text-dark">Autor:</strong>
                                <span class="text-muted">
                                    @(item.Author != null ? item.Author.FirstName + " " + item.Author.LastName : "Brak autora")
                                </span>
                            </p>

                            <!-- Opis -->
                            <p class="card-text text-muted small" style="line-height: 1.6;">
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    if (item.Description.Length > 120)
                                    {
                                        @item.Description.Substring(0, 120)<span>...</span>
                                    }
                                    else
                                    {
                                        @item.Description
                                    }
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Brak opisu</span>
                                }
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-light border-2 border-info text-center p-5 rounded-3">
            <h4 class="text-info fw-bold mb-3">📭 Biblioteka jest pusta!</h4>
            <p class="text-muted mb-4">Nie ma jeszcze żadnych książek. Dodaj pierwszą!</p>
            <a asp-action="AddBook" class="btn btn-primary btn-lg fw-bold rounded-pill px-5">
                <span>➕</span> Dodaj pierwszą książkę
            </a>
        </div>
    }
</div>

<style>
    .hover-shadow {
        transition: all 0.3s ease-in-out;
        transform: translateY(0);
    }

    .hover-shadow:hover {
        box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.15) !important;
        transform: translateY(-5px);
    }

    .card-footer a {
        transition: all 0.3s ease;
    }

    .card-footer a:hover {
        background-color: #0d6efd !important;
        color: white !important;
    }

    .display-4 {
        letter-spacing: -1px;
    }
</style>
