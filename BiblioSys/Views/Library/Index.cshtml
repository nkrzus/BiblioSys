@model IEnumerable<Bibliosys.Model.Book>

@{
    ViewData["Title"] = "Biblioteka Książek";
    int page = ViewBag.Page;
    int totalPages = ViewBag.TotalPages;
    string search = ViewBag.Search ?? "";
}

<div class="container mt-5 mb-5">
    @if (User.IsInRole("Admin"))
    {
        <div class="row mb-4 pb-4 border-bottom align-items-center">
            <div class="col-md-8">
                <h2 class="h4 fw-bold text-dark mb-2">Kolekcja książek</h2>
                <p class="text-muted mb-0">Wszystkie pozycje w naszej bibliotece</p>
            </div>
            <div class="col-md-4 text-end">
                <a asp-action="AddBook" class="btn btn-primary fw-semibold">Dodaj nową książkę</a>
            </div>
        </div>
    }
    else
    {
        <div class="row mb-4 pb-4 border-bottom">
            <div class="col-12">
                <h2 class="h4 fw-bold text-dark mb-2">Dostępne książki</h2>
                <p class="text-muted mb-0">Przeglądaj naszą bogatą kolekcję</p>
            </div>
        </div>
    }

    <div class="row mb-4">
        <div class="col-md-6">
            <form method="get" asp-action="Index" class="d-flex gap-2">
                <input type="text" name="search" value="@search" class="form-control" placeholder="Szukaj po tytule lub autorze..." />
                <button type="submit" class="btn btn-outline-primary fw-semibold">Szukaj</button>
                @if (!string.IsNullOrEmpty(search))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary fw-semibold">Wyczyść</a>
                }
            </form>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm book-card">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-dark mb-3 flex-grow-0" style="font-size: 1.1rem; line-height: 1.5; min-height: 2.2em;">
                                @Html.DisplayFor(modelItem => item.Title)
                            </h5>

                            <div class="mb-3 small">
                                <div class="mb-2">
                                    <span class="badge bg-light text-dark border border-secondary">
                                        @Html.DisplayFor(modelItem => item.Category)
                                    </span>
                                </div>
                                <div class="text-muted">
                                    <strong>Autor:</strong> @(item.Author != null ? item.Author.FirstName + " " + item.Author.LastName : "Brak autora")
                                </div>
                            </div>

                            <div class="mb-3">
                                @if (item.IsFree)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success fw-semibold">Dostępna</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger fw-semibold">Wypożyczona</span>
                                }
                            </div>

                            <hr class="my-2" />

                            <p class="card-text text-muted small flex-grow-1" style="line-height: 1.5;">
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    if (item.Description.Length > 120)
                                    {
                                        @item.Description.Substring(0, 120)
                                        <span>...</span>
                                    }
                                    else
                                    {
                                        @item.Description
                                    }
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Brak opisu</span>
                                }
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (totalPages > 1)
        {
            <nav class="mt-5">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(page <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(page - 1)" asp-route-search="@search">Poprzednia</a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@search">@i</a>
                        </li>
                    }
                    <li class="page-item @(page >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(page + 1)" asp-route-search="@search">Następna</a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="row mt-5">
            <div class="col-md-8 mx-auto text-center py-5">
                @if (!string.IsNullOrEmpty(search))
                {
                    <h4 class="text-dark fw-bold mb-3">Brak wyników dla „@search"</h4>
                    <p class="text-muted mb-4">Spróbuj wyszukać inną frazę.</p>
                    <a asp-action="Index" class="btn btn-outline-primary fw-semibold">Pokaż wszystkie</a>
                }
                else
                {
                    <h4 class="text-dark fw-bold mb-3">Brak książek w bibliotece</h4>
                    <p class="text-muted mb-5">Biblioteka jest obecnie pusta. Zaloguj się na konto administratora, aby dodać pierwszą pozycję.</p>
                    <a asp-action="Login" class="btn btn-primary fw-semibold me-2">Zaloguj się</a>
                    <a asp-action="AddUser" class="btn btn-outline-primary fw-semibold">Utwórz konto</a>
                }
            </div>
        </div>
    }
</div>

<style>
    .book-card {
        border-radius: 0.5rem;
        transition: all 0.2s ease-in-out;
    }

        .book-card:hover {
            box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.1) !important;
        }

    .card-body {
        padding: 1.5rem;
    }
</style>